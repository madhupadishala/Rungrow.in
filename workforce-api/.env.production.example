# Copy into the deployment provider's secret manager; never commit real values.
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/DBNAME?sslmode=require

# OIDC provider signing keys. Prefer JWKS URL; otherwise provide an asymmetric
# PEM public key (RSA or EC). HS256 is forbidden in production.
JWT_ISSUER=https://YOUR-OIDC-ISSUER/
JWT_AUDIENCE=rungrow-workforce-api
JWT_JWKS_URL=https://YOUR-OIDC-ISSUER/.well-known/jwks.json
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Independent service-to-service HMAC secrets; use random 32+ byte values.
STUDIO_GROWTH_OS_SERVICE_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
RUNGROW_ADAPTER_WEBHOOK_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
# Optional per-product overrides: RUNGROW_ADAPTER_SECRET_<PRODUCT_ID_UPPER_SNAKE_CASE>

# Internal tenant boundary and flagship product tenant mapping.
RUNGROW_INTERNAL_TENANT_ID=REPLACE_WITH_INTERNAL_TENANT_ID
STUDIO_GROWTH_OS_TENANT_MAP={}
STUDIO_GROWTH_OS_TENANT_SERVICE_TOKENS={}

# Durable worker identity and tenant/product scope.
WORKFORCE_WORKER_TENANT_ID=REPLACE_WITH_INTERNAL_TENANT_ID
WORKFORCE_WORKER_PRODUCT_IDS=photo-studio-growth-os,photo-studio-billing,clinics-counter,entrepreneur-instagram-tools,pharma-software-utilities,artists-business-tools,growtoys
WORKFORCE_WORKER_SCOPES=work.assign,agent.run
WORKFORCE_MODEL_PROVIDER=openai-compatible
WORKFORCE_PRIMARY_MODEL=gpt-4o-mini
# Configure provider credentials in the deployment secret manager as needed.
